<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access. The Flutter template declares this only in the debug
         and profile manifests, because there it is the tooling that needs it
         (the debug VM service talks to the host over the network). A RELEASE
         build built from the template therefore ships with no INTERNET
         permission at all, and everything that goes out over the network fails
         silently: the update check, and the telemetry pipeline,
         both of which swallow their errors by contract and so report nothing
         at all rather than reporting a failure.

         Found by a release-APK verification run that produced zero telemetry
         rows from an emulator whose network was demonstrably fine. Debug runs
         had always worked, which is exactly why it survived: `flutter run` is
         a debug build, and the debug manifest has the permission. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="WaveCrux"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- App launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
                Waveform file associations — "Open With WaveCrux" in file managers,
                email attachments, Slack shares, and cloud storage apps.

                Two filters per extension:
                  • file:// — direct filesystem access (local file managers, ADB push)
                  • content:// — content providers (email, cloud storage, Downloads)

                pathPattern matches the original filename in the URI path.
                android:host="*" accepts any provider authority.

                See docs/ARCHITECTURE.md §3.1.4 (File Loading on Mobile).
            -->

            <!-- VCD: Value Change Dump (ASCII text waveform format) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.vcd"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.vcd"/>
            </intent-filter>

            <!-- FST: Fast Signal Trace (binary, GTKWave-compatible) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.fst"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.fst"/>
            </intent-filter>

            <!-- GHW: GHDL Waveform (binary) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ghw"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.ghw"/>
            </intent-filter>

            <!-- LXT: GTKWave 2003 legacy waveform format -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.lxt"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.lxt"/>
            </intent-filter>

            <!-- LXT2: GTKWave 2005 block-indexed legacy waveform format -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.lxt2"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.lxt2"/>
            </intent-filter>

            <!-- .wavecrux: WaveCrux session files (JSON) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wavecrux"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.wavecrux"/>
            </intent-filter>

            <!-- .wavecruxpack: share bundles (zip). The one WaveCrux file
                 type that routinely arrives as an email attachment, which is
                 exactly where a phone opens things. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wavecruxpack"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.wavecruxpack"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
