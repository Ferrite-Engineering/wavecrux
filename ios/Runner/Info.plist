	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>WaveCrux</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Enables iOS to offer "Open in WaveCrux" for files served by Mail,
	  Safari downloads, AirDrop, etc.  Without
	  LSSupportsOpeningDocumentsInPlace, the share-sheet entry is
	  suppressed even though CFBundleDocumentTypes is declared, because
	  iOS treats the app as one that does not handle external documents.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- File type associations — enables "Open With WaveCrux" in the share sheet -->
