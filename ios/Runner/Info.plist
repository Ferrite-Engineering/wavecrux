			<array>
				<string>vcd</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Value Change Dump File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.wavecrux.vcd</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>fst</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Fast Signal Trace File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.wavecrux.fst</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>ghw</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>GHDL Waveform File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.wavecrux.ghw</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>lxt</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>LXT Legacy Waveform File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.wavecrux.lxt</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>lxt2</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>LXT2 Legacy Waveform File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.wavecrux.lxt2</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>wavecrux</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>WaveCrux Session File</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.wavecrux.session</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
	<!--
	  UTI declarations for WaveCrux-owned file types.

	  These types are defined by WaveCrux (we own the `com.wavecrux.*`
	  reverse-DNS namespace) so they belong under
	  `UTExportedTypeDeclarations`.  `UTImportedTypeDeclarations` is for types
	  declared elsewhere (by the system or another vendor) that this app
	  consumes.  iOS Mail / share-sheet integration silently ignores types in
	  the imported list when no other app exports them, so this must be
	  exported for "Open With WaveCrux" to appear when the user taps a `.vcd`
	  attachment.
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
	<!-- Imported, not exported: the formats below are other projects'. VCD is
	     IEEE 1364; FST and the LXT/LXT2 legacy dumps are GTKWave's; GHW is
	     GHDL's. Exporting one would declare WaveCrux the definer of a format
	     it only reads. What opens is unchanged — same identifiers, same
	     conformance, same extensions — and only who declares them moves. -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.wavecrux.vcd</string>
			<key>UTTypeDescription</key>
			<string>Value Change Dump File</string>
			<!--
			  Conform to BOTH plain-text and data: VCD is ASCII so plain-text
			  applies, but Mail and Files may tag the same attachment as
			  generic public.data when MIME is application/octet-stream.
			  Conforming to both lets either tag route the file to WaveCrux.
			-->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vcd</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/vcd</string>
					<string>text/plain</string>
					<string>application/octet-stream</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.wavecrux.fst</string>
			<key>UTTypeDescription</key>
			<string>Fast Signal Trace File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fst</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/octet-stream</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.wavecrux.ghw</string>
			<key>UTTypeDescription</key>
			<string>GHDL Waveform File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ghw</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/octet-stream</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.wavecrux.lxt</string>
			<key>UTTypeDescription</key>
			<string>LXT Legacy Waveform File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lxt</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/octet-stream</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.wavecrux.lxt2</string>
			<key>UTTypeDescription</key>
			<string>LXT2 Legacy Waveform File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lxt2</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/octet-stream</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.wavecrux.session</string>
			<key>UTTypeDescription</key>
