migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Cloudflare wrangler local cache (web app deploy — see scripts/deploy_web.sh)
.wrangler/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Native library build artifacts copied to project root for integration tests
# (macOS SIP strips DYLD_LIBRARY_PATH, so the dylib must be in CWD)
libwellen_ffi.dylib
libwellen_ffi.so
wellen_ffi.dll

# Android jniLibs — compiled by scripts/build_android.sh, not committed
/android/app/src/main/jniLibs/

# Flutter gen-l10n output (regenerated on build)
lib/l10n/generated/
lib/generated/
.dart_tool/flutter_gen/

# build_runner generated code (regenerated by `dart run build_runner build`)
*.g.dart
# ffigen-generated FFI bindings are .g.dart but require LLVM to regenerate — keep them
!lib/services/decoders/ffi/decoder_abi_bindings.g.dart

# wellen_wasm Rust build artefacts. wasm-pack writes into `native/wellen_wasm/pkg/`
# and `target/`; the committed copies that ship with the web build live in
# `web/wasm/`. Re-run `dart run tool/build_web_wasm.dart` to refresh them.
native/wellen_wasm/pkg/
native/wellen_wasm/target/

# lxt2fst Rust build artefacts — same pattern. Re-run
# `dart run tool/build_lxt2fst_wasm.dart` to refresh the committed
# `web/wasm/lxt2fst_bg.wasm` + `lxt2fst.js`.
native/lxt2fst/pkg/
native/lxt2fst/target/

# Flutter golden-test failure artifacts — master/test/diff PNGs written into a
# `failures/` dir next to a test whenever a golden mismatches locally. Transient
# and regenerated on the next failing run; never committed.
**/failures/

# Dart & Flutter DevTools local settings (per-developer, regenerated on demand)
devtools_options.yaml

# pubspec.lock IS tracked (2026-08-14). It was excluded as "path-dep version
# churn noise", and the cost of that showed up as CI going red on a commit that
# touched none of the affected code: CI resolves fresh every run, so
# `file_picker` publishing 12.0.0 broke the build while every local checkout
# kept passing from an older resolution. This is an application, not a library
# — the lock is the record of what was actually built and tested.

# Local environment files. None of these exist today, and none should: a
# public repo with outside contributors is where one gets committed by
# accident, and a secret in git history outlives its deletion.
.env
.env.*
!.env.example
# Two more spellings the `.env` rules above do not cover: Wrangler reads
# local secrets from `.dev.vars`, and direnv from `.envrc`. Both are files a
# contributor creates on their own machine, which is exactly how one gets
# committed.
.dev.vars
.dev.vars.*
.envrc
