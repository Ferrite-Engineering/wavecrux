  "editorHostInteractiveVcdTitle": "대화형 VCD에는 데스크톱 앱이 필요합니다",
  "@editorHostInteractiveVcdTitle": {
    "description": "Title of the interactive/streaming VCD capability boundary shown on the empty canvas inside an editor panel."
